{
  "name": "Twinter",
  "description": "Better customization, filtering, and control for Twitter",
  "version": "1.0",
  "homepage_url": "https://github.com/Matthbo/twinter-extension",
  "manifest_version": 2,
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"]
    }
  ]
